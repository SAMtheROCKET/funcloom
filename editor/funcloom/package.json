{
  "name": "funcloom",
  "displayName": "FuncLoom",
  "description": "FuncLoom, the Python functionizer: turn scripts, snippets and notebooks into verified functions and packages, locally. Experimental preview.",
  "keywords": [
    "python",
    "functionizer",
    "refactoring",
    "jupyter",
    "notebook",
    "modularization",
    "code quality"
  ],
  "version": "0.10.4",
  "toolVersion": "0.10.4a0",
  "publisher": "samtherocket",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://samtherocket.github.io/funcloom/",
  "bugs": {
    "url": "https://github.com/SAMtheROCKET/funcloom/issues"
  },
  "galleryBanner": {
    "color": "#0f5f48",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "funcloom.check",
        "title": "FuncLoom: Check active file"
      },
      {
        "command": "funcloom.snippet",
        "title": "FuncLoom: Draft function from selection or cell"
      },
      {
        "command": "funcloom.modularize",
        "title": "FuncLoom: Modularize to new folder"
      },
      {
        "command": "funcloom.refine",
        "title": "FuncLoom: Refine to new file"
      }
    ],
    "configuration": {
      "title": "FuncLoom",
      "properties": {
        "funcloom.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable to use. Leave empty to use the interpreter selected in the Python extension (or python on PATH); relative paths resolve from the workspace root."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SAMtheROCKET/funcloom"
  },
  "scripts": {
    "test": "node --test test/runner.test.js"
  }
}
