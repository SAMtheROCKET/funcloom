# Record with: vhs docs/media/funcloom-modularize.tape (from the repository root)
Output docs/media/funcloom-modularize.gif
Set FontSize 18
Set Width 1100
Set Height 620
Set Padding 20
Set TypingSpeed 45ms
Set Shell bash

Hide
Type "rm -rf /tmp/fl-demo && clear"
Enter
Show
Type "funcloom modularize examples/modular_sales_report.py --output /tmp/fl-demo"
Enter
Sleep 4s
Type "ls -R /tmp/fl-demo | head -20"
Enter
Sleep 3s
Type "python /tmp/fl-demo/main.py"
Enter
Sleep 3s
